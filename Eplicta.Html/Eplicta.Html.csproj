<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Version>2.0.0</Version>
		<Authors>Eplicta</Authors>
		<Company>Eplicta</Company>
		<Product>Eplicta Html archive renderer</Product>
		<PackageIcon>icon.png</PackageIcon>
		<LangVersion>latest</LangVersion>
		<PackageProjectUrl>https://github.com/Eplicta/Mets</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>html archive</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Eplicta.Html.csproj.DotSettings" />
	</ItemGroup>

	<ItemGroup>
		<None Include="icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>